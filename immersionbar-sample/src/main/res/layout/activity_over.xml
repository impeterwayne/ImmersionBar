<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darker_gray"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        app:title="@string/text_over"
        app:titleTextColor="@android:color/white" />

    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@android:color/black"
        android:textSize="15sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_one"
                style="@style/btn"
                android:text="@string/text_method_1" />

            <Button
                android:id="@+id/btn_two"
                style="@style/btn"
                android:text="@string/text_method_2" />

            <Button
                android:id="@+id/btn_three"
                style="@style/btn"
                android:text="@string/text_method_3" />

            <Button
                android:id="@+id/btn_four"
                style="@style/btn"
                android:text="@string/text_method_4" />

            <Button
                android:id="@+id/btn_five"
                style="@style/btn"
                android:text="@string/text_method_5" />

            <Button
                android:id="@+id/btn_six"
                style="@style/btn"
                android:text="@string/text_method_6" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>