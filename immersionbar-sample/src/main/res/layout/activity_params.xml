<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/btn13"
        app:title="@string/title_params_info"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPortrait"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="@string/text_is_portrait"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvLandscapeLeft"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="@string/text_is_landscape_left"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvLandscapeRight"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="@string/text_is_landscape_right"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="@string/text_status_bar_height_current"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvStatusIgnoringVisibility"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="@string/text_status_bar_height_ignore_visibility"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvStatusVisible"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="@string/text_is_status_bar_visible"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvHasNav"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="@string/text_has_navigation_bar"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvNavVisible"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="@string/text_is_navigation_bar_visible"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvNavAtBottom"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="@string/text_is_navigation_bar_at_bottom"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvNavType"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="@string/text_navigation_bar_type"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvNav"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="@string/text_navigation_bar_height_current"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvNavIgnoringVisibility"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="@string/text_navigation_bar_height_ignore_visibility"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvNavWidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:gravity="center"
                android:text="@string/text_navigation_bar_width_desc"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvGesture"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="@string/text_has_gesture_navigation"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvHasNotch"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="@string/text_has_notch_screen"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvNotchHeight"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="@string/text_notch_height"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvAction"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="ActionBar Height:"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvInsets"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="WindowInsetTop："
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvFits"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="@string/text_is_fits_system_windows"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvStatusDark"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="@string/text_is_support_status_bar_dark_font"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvNavigationDark"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="@string/text_is_support_navigation_bar_dark_icon"
                android:textColor="@android:color/black" />

            <Button
                android:id="@+id/btnStatus"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginBottom="20dp"
                android:background="@color/btn13"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/text_demo_toggle_status_bar_static"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnNavigation"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginBottom="20dp"
                android:background="@color/btn13"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/text_demo_toggle_nav_bar_param"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
